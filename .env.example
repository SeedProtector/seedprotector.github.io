# ========================================
# Seed 网站环境变量配置
# ========================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 然后运行注入脚本：
#   bash scripts/tools/inject_env.sh
# ========================================

# 联系邮箱（用于接收表单提交）
SEED_CONTACT_EMAIL=

# EmailJS 配置（https://www.emailjs.com）
# 注册后在 Dashboard 获取以下信息
SEED_EMAILJS_PUBLIC_KEY=
SEED_EMAILJS_SERVICE_ID=
SEED_EMAILJS_TEMPLATE_ID=
